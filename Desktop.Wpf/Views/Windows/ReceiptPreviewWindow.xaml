<ui:FluentWindow x:Class="SmartSupermarket.POS.Views.Windows.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Xem Trước Hóa Đơn"
        Height="720" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="440" MinHeight="580"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Inter, Arial"
        Background="#FFFFFF">

    <ui:FluentWindow.Resources>
        <Style x:Key="TitleCloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrintBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="#0284C7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="#F1F5F9"
                                BorderThickness="1" BorderBrush="#CBD5E1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Receipt line separator -->
        <Style x:Key="ReceiptDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#D1D5DB"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>
        <Style x:Key="ReceiptDashedDivider" TargetType="TextBlock">
            <Setter Property="Text" Value="- - - - - - - - - - - - - - - - - - - - - - - -"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Draggable Custom TitleBar -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ui:SymbolIcon Symbol="Receipt24" FontSize="16" Foreground="#0284C7" Margin="0,0,8,0"/>
                    <TextBlock Text="Xem Trước Hóa Đơn K80" FontSize="13" FontWeight="SemiBold"
                               Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="Transparent"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleCloseBtnStyle}" Click="BtnClose_Click" ToolTip="Đóng">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="#64748B"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Receipt Paper Container -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F1F5F9"
                      Padding="24,16,24,16">
            <Border x:Name="PnlReceiptContent"
                    Background="White" CornerRadius="4"
                    MaxWidth="380" HorizontalAlignment="Center"
                    Padding="24,20">
                <Border.Effect>
                    <DropShadowEffect Color="#64748B" BlurRadius="20" ShadowDepth="4" Opacity="0.15" Direction="270"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Store Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="🛒 KATQ SUPERMARKET" FontSize="15" FontWeight="Bold"
                                   Foreground="#111827" HorizontalAlignment="Center" FontFamily="Consolas"/>
                        <TextBlock Text="HỆ THỐNG BÁN LẺ THÔNG MINH" FontSize="10" Foreground="#6B7280"
                                   HorizontalAlignment="Center" FontFamily="Consolas"/>
                        <TextBlock Text="ĐC: 123 Đường Thương Mại, Q.1, TP.HCM" FontSize="10"
                                   Foreground="#6B7280" HorizontalAlignment="Center" FontFamily="Consolas" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="Hotline: 028-1234-5678" FontSize="10" Foreground="#6B7280"
                                   HorizontalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource ReceiptDashedDivider}"/>

                    <!-- Bill Title -->
                    <TextBlock Text="HÓA ĐƠN BÁN HÀNG" FontSize="13" FontWeight="Bold"
                               Foreground="#111827" HorizontalAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,0,4"/>

                    <TextBlock Style="{StaticResource ReceiptDashedDivider}"/>

                    <!-- Order Info -->
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Mã đơn:" FontSize="11" Foreground="#6B7280" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtOrderCode" Text="ORD-00001" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="#111827" FontFamily="Consolas"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Thời gian:" FontSize="11" Foreground="#6B7280" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtOrderTime" Text="--/--/---- --:--:--" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#111827" FontFamily="Consolas"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Thu ngân:" FontSize="11" Foreground="#6B7280" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtCashier" Text="Thu Ngân" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#111827" FontFamily="Consolas"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Khách hàng:" FontSize="11" Foreground="#6B7280" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtCustomer" Text="Khách Lẻ" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#111827" FontFamily="Consolas"/>
                    </Grid>

                    <TextBlock Style="{StaticResource ReceiptDashedDivider}"/>

                    <!-- Product Table Header -->
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SẢN PHẨM" FontSize="11" FontWeight="Bold" Foreground="#374151" FontFamily="Consolas"/>
                        <TextBlock Grid.Column="1" Text="SL" FontSize="11" FontWeight="Bold" Foreground="#374151" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="TIỀN" FontSize="11" FontWeight="Bold" Foreground="#374151" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Items List -->
                    <ItemsControl x:Name="IcReceiptItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="11"
                                               Foreground="#111827" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="11"
                                               Foreground="#111827" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedTotal}" FontSize="11"
                                               Foreground="#111827" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource ReceiptDashedDivider}"/>

                    <!-- Summary -->
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Tạm tính:" FontSize="11" Foreground="#6B7280" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtSubTotal" Text="0 đ" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#111827" FontFamily="Consolas"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Thuế VAT (8%):" FontSize="11" Foreground="#6B7280" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtVat" Text="0 đ" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#111827" FontFamily="Consolas"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Giảm giá:" FontSize="11" Foreground="#6B7280" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtDiscount" Text="-0 đ" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#059669" FontFamily="Consolas"/>
                    </Grid>

                    <Border Style="{StaticResource ReceiptDivider}"/>

                    <!-- Grand Total -->
                    <Grid Margin="0,4,0,4">
                        <TextBlock Text="TỔNG THANH TOÁN:" FontSize="13" FontWeight="Bold"
                                   Foreground="#111827" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtGrandTotal" Text="0 đ" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="#0284C7" FontFamily="Consolas"/>
                    </Grid>

                    <TextBlock Style="{StaticResource ReceiptDashedDivider}"/>

                    <!-- Payment Method + Change -->
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Phương thức:" FontSize="11" Foreground="#6B7280" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtPaymentMethod" Text="Tiền Mặt" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#374151" FontFamily="Consolas"/>
                    </Grid>
                    <Grid x:Name="RowCashDetails" Margin="0,2,0,2">
                        <TextBlock Text="Tiền thối:" FontSize="11" Foreground="#6B7280" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtChangeDue" Text="0 đ" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="#059669" FontFamily="Consolas" FontWeight="Bold"/>
                    </Grid>

                    <TextBlock Style="{StaticResource ReceiptDashedDivider}"/>

                    <!-- Footer -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Cảm ơn Quý Khách đã mua hàng!" FontSize="11"
                                   Foreground="#374151" HorizontalAlignment="Center" FontFamily="Consolas"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Hẹn gặp lại Quý Khách ☺" FontSize="11" Foreground="#6B7280"
                                   HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,2,0,0"/>
                        <TextBlock Text="www.katqsupermarket.vn" FontSize="10" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource CloseBtn}" Click="BtnClose_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B" Margin="0,0,8,0"/>
                        <TextBlock Text="Đóng" Foreground="#475569" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource PrintBtn}" Click="BtnPrint_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Print24" FontSize="16" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="In Hóa Đơn K80" Foreground="White" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>