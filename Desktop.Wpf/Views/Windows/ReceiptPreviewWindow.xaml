<ui:FluentWindow x:Class="SmartSupermarket.POS.Views.Windows.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hóa Đơn Bán Lẻ" Height="680" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Xem Trước Hóa Đơn K80" />

        <!-- Thermal Receipt Body (Border with white paper style) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                Padding="16" Margin="0,10,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PnlReceiptContent">
                    <!-- Store Brand Header -->
                    <TextBlock Text="SIÊU THỊ THÔNG MINH KATQ" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Chi Nhánh 01 - Trụ Sở Chính" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock Text="Hotline: 1900 6868 • MST: 0312456789" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,8" />

                    <Separator Margin="0,4,0,8" />

                    <!-- Order Metadata -->
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Mã đơn:" FontSize="11" Foreground="#64748B" />
                        <TextBlock x:Name="TxtOrderCode" Text="ORD-00001" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Thời gian:" FontSize="11" Foreground="#64748B" />
                        <TextBlock x:Name="TxtOrderTime" Text="24/10/2026 19:30" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Thu ngân:" FontSize="11" Foreground="#64748B" />
                        <TextBlock x:Name="TxtCashier" Text="Thu Ngân POS" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Khách hàng:" FontSize="11" Foreground="#64748B" />
                        <TextBlock x:Name="TxtCustomer" Text="Khách Lẻ" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>

                    <Separator Margin="0,8,0,8" />

                    <!-- Items Table Header -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="35" />
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tên Hàng" FontSize="10.5" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="SL" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Đơn Giá" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="T.Tiền" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Items Rows Container -->
                    <ItemsControl x:Name="IcReceiptItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="11" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedUnitPrice}" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedTotal}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,8,0,8" />

                    <!-- Financial Summary -->
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Tạm tính:" FontSize="11" Foreground="#64748B" />
                        <TextBlock x:Name="TxtSubTotal" Text="0 đ" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Thuế VAT (8%):" FontSize="11" Foreground="#64748B" />
                        <TextBlock x:Name="TxtVat" Text="0 đ" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Giảm giá / Voucher:" FontSize="11" Foreground="#059669" />
                        <TextBlock x:Name="TxtDiscount" Text="0 đ" FontSize="11" Foreground="#059669" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,6,0,4">
                        <TextBlock Text="TỔNG TIỀN PHẢI THU:" FontSize="13" FontWeight="Bold" />
                        <TextBlock x:Name="TxtGrandTotal" Text="0 đ" FontSize="15" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Phương thức:" FontSize="11" Foreground="#64748B" />
                        <TextBlock x:Name="TxtPaymentMethod" Text="Tiền mặt" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid x:Name="RowCashDetails" Margin="0,2,0,2">
                        <TextBlock Text="Tiền thối lại:" FontSize="11" Foreground="#64748B" />
                        <TextBlock x:Name="TxtChangeDue" Text="0 đ" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>

                    <Separator Margin="0,10,0,10" />

                    <!-- Footer Note & Barcode -->
                    <TextBlock Text="CẢM ƠN QUÝ KHÁCH &amp; HẸN GẶP LẠI!" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Hóa đơn có giá trị đổi trả trong vòng 3 ngày cùng hóa đơn gốc" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="* * * * *" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#CBD5E1" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Actions -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,6,0,0">
            <ui:Button Content="Đóng" Appearance="Secondary" Height="40" Margin="0,0,6,0" Click="BtnClose_Click" />
            <ui:Button Content="🖨️ In Hóa Đơn (K80)" Appearance="Primary" Height="40" Margin="6,0,0,0" Click="BtnPrint_Click" />
        </UniformGrid>
    </Grid>
</ui:FluentWindow>
