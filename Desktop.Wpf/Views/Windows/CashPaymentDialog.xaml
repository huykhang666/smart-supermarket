<ui:FluentWindow x:Class="SmartSupermarket.POS.Views.Windows.CashPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Thanh Toán Tiền Mặt" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Xác Nhận Thu Tiền Mặt" />

        <!-- Total Bill Amount Card -->
        <ui:Card Grid.Row="1" Margin="0,12,0,16" Padding="16">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="SỐ TIỀN CẦN THANH TOÁN" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="TxtTotalAmount" Text="0 đ" FontSize="26" FontWeight="Bold"
                           Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </ui:Card>

        <!-- Cash Input & Quick Tender Buttons -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Tiền khách đưa (VNĐ):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ui:TextBox x:Name="TxtCashGiven" Height="40" FontSize="18" FontWeight="Bold"
                        PlaceholderText="0" TextChanged="TxtCashGiven_TextChanged" />

            <!-- Quick Tender Chips -->
            <TextBlock Text="Gợi ý tiền mệnh giá nhanh:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,6" />
            <UniformGrid Columns="3" Margin="0,0,0,14">
                <ui:Button Content="Tiền đúng" Margin="3" Height="32" Click="QuickCash_Click" Tag="EXACT" />
                <ui:Button Content="50.000 đ" Margin="3" Height="32" Click="QuickCash_Click" Tag="50000" />
                <ui:Button Content="100.000 đ" Margin="3" Height="32" Click="QuickCash_Click" Tag="100000" />
                <ui:Button Content="200.000 đ" Margin="3" Height="32" Click="QuickCash_Click" Tag="200000" />
                <ui:Button Content="500.000 đ" Margin="3" Height="32" Click="QuickCash_Click" Tag="500000" />
                <ui:Button Content="1.000.000 đ" Margin="3" Height="32" Click="QuickCash_Click" Tag="1000000" />
            </UniformGrid>

            <!-- Change Return Calculation Card -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <TextBlock Text="Tiền thối lại khách:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtChangeDue" Text="0 đ" FontSize="18" FontWeight="Bold"
                               Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Actions -->
        <UniformGrid Grid.Row="3" Columns="2" Margin="0,16,0,0">
            <ui:Button Content="Hủy bỏ (Esc)" Appearance="Secondary" Height="42" Margin="0,0,6,0" Click="BtnCancel_Click" />
            <ui:Button x:Name="BtnConfirm" Content="Xác nhận &amp; In hóa đơn" Appearance="Primary" Height="42" Margin="6,0,0,0" Click="BtnConfirm_Click" />
        </UniformGrid>
    </Grid>
</ui:FluentWindow>
