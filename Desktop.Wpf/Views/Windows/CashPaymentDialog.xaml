<ui:FluentWindow x:Class="SmartSupermarket.POS.Views.Windows.CashPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Thanh Toán Tiền Mặt"
        Height="560" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Inter, Arial"
        Background="#FFFFFF">

    <ui:FluentWindow.Resources>
        <!-- Quick cash chip style -->
        <Style x:Key="CashChip" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Exact cash chip: special green -->
        <Style x:Key="ExactCashChip" TargetType="Button" BasedOn="{StaticResource CashChip}">
            <Setter Property="Foreground" Value="#047857"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#ECFDF5" BorderBrush="#6EE7B7"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#D1FAE5"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#34D399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Confirm button -->
        <Style x:Key="ConfirmBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="#0284C7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#94A3B8"/>
                                <Setter TargetName="bg" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel button -->
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="#F1F5F9"
                                BorderThickness="1" BorderBrush="#CBD5E1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TitleBar window control buttons -->
        <Style x:Key="TitleCloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Draggable Custom TitleBar -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ui:SymbolIcon Symbol="Money24" FontSize="16" Foreground="#0284C7" Margin="0,0,8,0"/>
                    <TextBlock Text="Thanh Toán Tiền Mặt" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="Transparent"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleCloseBtnStyle}" Click="BtnCancel_Click" ToolTip="Đóng">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="#64748B"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24,18,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Total Amount Display -->
            <Border Grid.Row="0" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                    CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="SỐ TIỀN CẦN THANH TOÁN" FontSize="11" FontWeight="Bold"
                               Foreground="#0284C7" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalAmount" Text="0 đ"
                               FontSize="30" FontWeight="Bold" Foreground="{StaticResource Primary600Brush}" Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Cash Input -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Tiền khách đưa (VNĐ):" FontSize="13" FontWeight="SemiBold"
                           Foreground="#475569" Margin="0,0,0,6"/>
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5"
                        CornerRadius="8" Height="48" Padding="14,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=TxtCashGiven, Path=IsFocused}" Value="True">
                                    <Setter Property="BorderBrush" Value="#0284C7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="TxtCashGiven" Background="Transparent" BorderThickness="0"
                             Foreground="#0F172A" CaretBrush="#0284C7"
                             FontSize="22" FontWeight="Bold"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtCashGiven_TextChanged"/>
                </Border>
            </StackPanel>

            <!-- Quick Denomination Chips -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="MỆNH GIÁ NHANH:" FontSize="11" FontWeight="Bold"
                           Foreground="#64748B" Margin="0,0,0,8"/>
                <UniformGrid Columns="3" Margin="0,0,0,0">
                    <Button Content="✓ Tiền đúng" Style="{StaticResource ExactCashChip}"
                            Margin="0,0,6,6" Click="QuickCash_Click" Tag="EXACT"/>
                    <Button Content="50.000 đ" Style="{StaticResource CashChip}"
                            Margin="3,0,3,6" Click="QuickCash_Click" Tag="50000"/>
                    <Button Content="100.000 đ" Style="{StaticResource CashChip}"
                            Margin="6,0,0,6" Click="QuickCash_Click" Tag="100000"/>
                    <Button Content="200.000 đ" Style="{StaticResource CashChip}"
                            Margin="0,0,6,6" Click="QuickCash_Click" Tag="200000"/>
                    <Button Content="500.000 đ" Style="{StaticResource CashChip}"
                            Margin="3,0,3,6" Click="QuickCash_Click" Tag="500000"/>
                    <Button Content="1.000.000 đ" Style="{StaticResource CashChip}"
                            Margin="6,0,0,6" Click="QuickCash_Click" Tag="1000000"/>
                </UniformGrid>
            </StackPanel>

            <!-- Change Due -->
            <Border Grid.Row="3" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1"
                    CornerRadius="10" Padding="16,10" Margin="0,8,0,16">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TIỀN THỐI LẠI KHÁCH" FontSize="11" FontWeight="Bold"
                                   Foreground="#15803D"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtChangeDue" Text="0 đ"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Typography.NumeralAlignment="Tabular"/>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource CancelBtn}" Click="BtnCancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B" Margin="0,0,8,0"/>
                        <TextBlock Text="Hủy bỏ (Esc)" Foreground="#475569" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" x:Name="BtnConfirm" Style="{StaticResource ConfirmBtn}"
                        Click="BtnConfirm_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="Xác nhận &amp; In" Foreground="White" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>