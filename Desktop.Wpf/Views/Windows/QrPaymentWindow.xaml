<ui:FluentWindow x:Class="SmartSupermarket.POS.Views.Windows.QrPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Thanh Toán VietQR"
        Height="600" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Inter, Arial"
        Background="#FFFFFF">

    <ui:FluentWindow.Resources>
        <Style x:Key="TitleCloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmQrBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="#10B981">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelQrBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="#F1F5F9"
                                BorderThickness="1" BorderBrush="#CBD5E1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Draggable Custom TitleBar -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ui:SymbolIcon Symbol="QrCode24" FontSize="16" Foreground="#0284C7" Margin="0,0,8,0"/>
                    <TextBlock Text="Thanh Toán VietQR Banking" FontSize="13" FontWeight="SemiBold"
                               Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="Transparent"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleCloseBtnStyle}" Click="BtnCancel_Click" ToolTip="Đóng">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="#64748B"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24,18,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Amount Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="QUÉT MÃ QR ĐỂ THANH TOÁN" FontSize="11" FontWeight="Bold"
                           Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtAmount" Text="0 đ"
                           FontSize="32" FontWeight="Bold" Foreground="{StaticResource Primary600Brush}" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Đang chờ thanh toán..." FontSize="12" Foreground="#047857" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <!-- QR Code Card -->
            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="14" Padding="14" Width="250" Height="250">
                <Border.Effect>
                    <DropShadowEffect Color="#64748B" BlurRadius="20" ShadowDepth="4" Opacity="0.12" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <!-- Outer border decoration -->
                    <Border BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="8">
                        <Image x:Name="ImgQrCode" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Width="216" Height="216" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Bank Logos Row -->
            <StackPanel Grid.Row="2" Margin="0,16,0,18">
                <TextBlock Text="Hỗ trợ tất cả ngân hàng Việt Nam qua VietQR" FontSize="12"
                           Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <TextBlock Text="MB Bank" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <TextBlock Text="VietinBank" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <TextBlock Text="Vietcombank" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <TextBlock Text="BIDV" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <TextBlock Text="MoMo" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource CancelQrBtn}" Click="BtnCancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B" Margin="0,0,8,0"/>
                        <TextBlock Text="Hủy giao dịch" Foreground="#475569" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ConfirmQrBtn}" Click="BtnConfirm_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="Đã nhận tiền ✓" Foreground="White" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>