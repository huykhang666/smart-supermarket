<ui:FluentWindow x:Class="SmartSupermarket.POS.Views.Windows.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:SmartSupermarket.POS.Views.Pages"
        Title="KATQ Smart Supermarket • Admin Enterprise Workstation"
        Height="800" Width="1280" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 TitleBar with User Profile & Logout -->
        <ui:TitleBar Grid.Row="0" Title="KATQ Smart Supermarket • Trung Tâm Quản Trị ERP &amp; POS">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Status Badge -->
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="8,3,8,3" Margin="0,0,8,0">
                        <TextBlock Text="🟢 Hệ Thống Online • Admin Ready" FontSize="11" FontWeight="SemiBold" Foreground="#059669" />
                    </Border>

                    <!-- User Profile Chip -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="8,3,8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtUserProfile" Text="👑 Quản Trị Viên (Admin)" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" />
                    </Border>

                    <!-- Logout Button -->
                    <ui:Button Content="Đăng Xuất" Appearance="Transparent" Height="26" Padding="6,0,6,0" Click="BtnLogout_Click" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- NavigationView Sidebar -->
        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="220">

            <!-- Primary Navigation Items -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Tổng Quan ERP"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:DashboardPage}" />

                <ui:NavigationViewItem Content="POS Bán Hàng"
                                       Icon="{ui:SymbolIcon Cart24}"
                                       TargetPageType="{x:Type pages:PosPage}" />

                <ui:NavigationViewItem Content="Hàng Hóa &amp; Giá"
                                       Icon="{ui:SymbolIcon Box24}"
                                       TargetPageType="{x:Type pages:ProductsPage}" />

                <ui:NavigationViewItem Content="Đơn Hàng &amp; HĐ"
                                       Icon="{ui:SymbolIcon Receipt24}"
                                       TargetPageType="{x:Type pages:OrdersPage}" />
            </ui:NavigationView.MenuItems>

            <!-- Footer Navigation Items -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Cài Đặt Hệ Thống"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
