<ui:FluentWindow x:Class="SmartSupermarket.POS.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Smart Supermarket • Đăng Nhập Hệ Thống POS"
        Height="740" Width="1200"
        MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None">

    <Window.Resources>
        <!-- Glassmorphic Transparent TextBox Template -->
        <Style x:Key="GlassInputTextStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="SelectionBrush" Value="#38BDF8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glassmorphic Transparent PasswordBox Template -->
        <Style x:Key="GlassInputPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="SelectionBrush" Value="#38BDF8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TitleBar Action Buttons (Minimize, Maximize, Close) -->
        <Style x:Key="TitleBarActionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button (Red Glow on Hover) -->
        <Style x:Key="TitleBarCloseActionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#E11D48" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#BE123C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Supermarket Gourmet Poster -->
        <Image Source="pack://application:,,,/Assets/Images/pos_login_poster.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <!-- Atmospheric Vignette Overlay for Depth & High Readability -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#15000000" Offset="0.0" />
                    <GradientStop Color="#05000000" Offset="0.45" />
                    <GradientStop Color="#40030712" Offset="0.72" />
                    <GradientStop Color="#8002050B" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Main Window Container -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom TitleBar with High-Contrast Visible Controls -->
            <Grid Grid.Row="0" Background="#35000000" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="16" Foreground="#38BDF8" Margin="0,0,8,0" />
                    <TextBlock Text="KATQ Supermarket"
                               Foreground="#CBD5E1" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center Drag Region -->
                <Rectangle Grid.Column="1" Fill="Transparent" />

                <!-- Right Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarActionBtn}" Click="BtnMinimize_Click" ToolTip="Thu nhỏ">
                        <ui:SymbolIcon Symbol="Subtract16" FontSize="14" Foreground="#E2E8F0" />
                    </Button>
                    <Button Style="{StaticResource TitleBarActionBtn}" Click="BtnMaximize_Click" ToolTip="Phóng to / Thu nhỏ">
                        <ui:SymbolIcon Symbol="Maximize16" FontSize="14" Foreground="#E2E8F0" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseActionBtn}" Click="BtnClose_Click" ToolTip="Đóng">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="14" Foreground="#FFFFFF" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2-Column Split: Left (Brand Art Presentation) & Right (Glassmorphism Login Card) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Elegant Brand Tagline & Supermarket Identity -->
                <Grid Grid.Column="0" Margin="48,0,0,36" VerticalAlignment="Bottom">
                    <StackPanel>
                        <!-- Main Brand Title -->
                        <TextBlock Text="KATQ SUPERMARKET"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="#FFFFFF" Margin="0,0,0,2">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.8" />
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Clean Sub-tagline -->
                        <TextBlock Text="Hệ thống Bán lẻ &amp; Quản trị Siêu thị"
                                   FontSize="13.5" FontWeight="Normal"
                                   Foreground="#94A3B8" />
                    </StackPanel>
                </Grid>

                <!-- Right Column: Glassmorphic Floating Login Card -->
                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,10,60,20">
                    <StackPanel Width="400">

                        <!-- Premium Glassmorphism Card Container -->
                        <Grid>
                            <!-- Ambient Glow Halo Underlay -->
                            <Border CornerRadius="28" Background="#1200F0FF" Margin="-4">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0284C7" BlurRadius="55" ShadowDepth="0" Opacity="0.55" />
                                </Border.Effect>
                            </Border>

                            <!-- Glass Card Frame with Specular Highlight Border -->
                            <Border CornerRadius="26"
                                    BorderThickness="1.5"
                                    Padding="34,32,34,30">
                                <!-- Multi-stop Specular Glass Light Border -->
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#C038BDF8" Offset="0.0" />
                                        <GradientStop Color="#40FFFFFF" Offset="0.25" />
                                        <GradientStop Color="#1538BDF8" Offset="0.65" />
                                        <GradientStop Color="#9006B6D4" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>

                                <!-- Frosted Acrylic Translucent Dark Glass -->
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#450F1E32" Offset="0.0" />
                                        <GradientStop Color="#550A1424" Offset="0.5" />
                                        <GradientStop Color="#75030812" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <StackPanel>
                                    <!-- Header: SIGN IN -->
                                    <TextBlock Text="SIGN IN"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,18">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.7" />
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <!-- Circular Profile Medallion / Avatar Icon -->
                                    <Border Width="72" Height="72"
                                            CornerRadius="36"
                                            BorderThickness="2"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,26">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#00F0FF" Offset="0.0" />
                                                <GradientStop Color="#38BDF8" Offset="0.45" />
                                                <GradientStop Color="#2563EB" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                <GradientStop Color="#3500F0FF" Offset="0.0" />
                                                <GradientStop Color="#15000000" Offset="1.0" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00F0FF" BlurRadius="18" ShadowDepth="0" Opacity="0.8" />
                                        </Border.Effect>
                                        <ui:SymbolIcon Symbol="Person24" FontSize="36" Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Username Input Pill Capsule (Bo góc viên thuốc sang trọng) -->
                                    <Border x:Name="BorderUsername"
                                            CornerRadius="24" Height="48"
                                            Background="#250F1D30"
                                            BorderThickness="1.2"
                                            BorderBrush="#3564748B"
                                            Margin="0,0,0,16"
                                            Padding="18,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="Person20" FontSize="18" Foreground="#38BDF8" Margin="0,0,12,0" />
                                            <Grid Grid.Column="1">
                                                <!-- Watermark Placeholder Text -->
                                                <TextBlock x:Name="PlaceholderUsername"
                                                           Text="Tên đăng nhập"
                                                           Foreground="#64748B"
                                                           FontSize="13.5"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False" />
                                                <!-- Glass Input Box -->
                                                <TextBox x:Name="TxtUsername"
                                                         Style="{StaticResource GlassInputTextStyle}"
                                                         GotFocus="InputBox_GotFocus"
                                                         LostFocus="InputBox_LostFocus"
                                                         TextChanged="TxtUsername_TextChanged" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Password Input Pill Capsule -->
                                    <Border x:Name="BorderPassword"
                                            CornerRadius="24" Height="48"
                                            Background="#250F1D30"
                                            BorderThickness="1.2"
                                            BorderBrush="#3564748B"
                                            Margin="0,0,0,18"
                                            Padding="18,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed20" FontSize="18" Foreground="#38BDF8" Margin="0,0,12,0" />
                                            <Grid Grid.Column="1">
                                                <!-- Watermark Placeholder Text -->
                                                <TextBlock x:Name="PlaceholderPassword"
                                                           Text="Mật khẩu"
                                                           Foreground="#64748B"
                                                           FontSize="13.5"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False" />
                                                <!-- Glass Password Box -->
                                                <PasswordBox x:Name="TxtPassword"
                                                             Style="{StaticResource GlassInputPasswordStyle}"
                                                             GotFocus="PasswordBox_GotFocus"
                                                             LostFocus="PasswordBox_LostFocus"
                                                             PasswordChanged="TxtPassword_PasswordChanged" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Status / Alert Message -->
                                    <TextBlock x:Name="TxtStatus" Text=""
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#38BDF8"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,12"
                                               TextWrapping="Wrap" />

                                    <!-- Modern Pill LOGIN Button with Specular Glass Light & Rich Bloom -->
                                    <Button x:Name="BtnLogin"
                                            HorizontalAlignment="Stretch"
                                            Height="48"
                                            Margin="0,0,0,20"
                                            Click="BtnLogin_Click"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder"
                                                        CornerRadius="24"
                                                        BorderThickness="1"
                                                        BorderBrush="#6093C5FD">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#1E40AF" Offset="0.0" />
                                                            <GradientStop Color="#2563EB" Offset="0.45" />
                                                            <GradientStop Color="#3B82F6" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#2563EB" BlurRadius="26" ShadowDepth="0" Opacity="0.85" />
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#2563EB" Offset="0.0" />
                                                                    <GradientStop Color="#3B82F6" Offset="0.5" />
                                                                    <GradientStop Color="#60A5FA" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#A0BFDBFE" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.88" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="ĐĂNG NHẬP"
                                                   FontSize="14.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF" />
                                    </Button>

                                    <!-- Footer Links: Quên mật khẩu? & Trợ giúp -->
                                    <Grid Margin="4,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Quên mật khẩu?"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Left"
                                                   Cursor="Hand"
                                                   MouseDown="LinkForgotPassword_Click">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#38BDF8" />
                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1"
                                                   Text="Trợ giúp"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Right"
                                                   Cursor="Hand"
                                                   MouseDown="LinkNeedHelp_Click">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#38BDF8" />
                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>