<ui:FluentWindow x:Class="SmartSupermarket.POS.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Smart Supermarket • Đăng Nhập Hệ Thống POS"
        Height="710" Width="1160"
        MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Inter, Arial"
        PreviewKeyDown="Window_PreviewKeyDown">

        <Window.Resources>
        <!-- Glassmorphic Transparent TextBox Template -->
        <Style x:Key="ModernInputTextStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SelectionBrush" Value="#38BDF8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glassmorphic Transparent PasswordBox Template -->
        <Style x:Key="ModernInputPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SelectionBrush" Value="#38BDF8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pin Pad Key Button Style -->
        <Style x:Key="PinKeyBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#251E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#253347"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C740"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TitleBar Action Buttons (Minimize, Maximize, Close) -->
        <Style x:Key="TitleBarActionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button (Red on Hover) -->
        <Style x:Key="TitleBarCloseActionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#E11D48" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#BE123C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Supermarket Gourmet Poster -->
        <Image Source="pack://application:,,,/Assets/Images/pos_login_poster.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <!-- Atmospheric Soft Gradient Overlay -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#10000000" Offset="0.0" />
                    <GradientStop Color="#00000000" Offset="0.45" />
                    <GradientStop Color="#45030712" Offset="0.70" />
                    <GradientStop Color="#8002050B" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Main Window Container -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Clean TitleBar -->
            <Grid Grid.Row="0" Background="#30000000" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 1,1 L 4,1 L 6.68,13.4 C 6.8,14 7.3,14.5 8,14.5 L 18.5,14.5 C 19.2,14.5 19.7,14 19.85,13.4 L 22,4.5 L 5.5,4.5"
                                  Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Ellipse Canvas.Left="7" Canvas.Top="17.5" Width="3" Height="3" Fill="#38BDF8" />
                            <Ellipse Canvas.Left="17" Canvas.Top="17.5" Width="3" Height="3" Fill="#38BDF8" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="KATQ Supermarket"
                               Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center Drag Region -->
                <Rectangle Grid.Column="1" Fill="Transparent" />

                <!-- Right Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarActionBtn}" Click="BtnMinimize_Click" ToolTip="Thu nhỏ">
                        <ui:SymbolIcon Symbol="Subtract16" FontSize="14" Foreground="#E2E8F0" />
                    </Button>
                    <Button Style="{StaticResource TitleBarActionBtn}" Click="BtnMaximize_Click" ToolTip="Phóng to / Thu nhỏ">
                        <ui:SymbolIcon Symbol="Maximize16" FontSize="14" Foreground="#E2E8F0" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseActionBtn}" Click="BtnClose_Click" ToolTip="Đóng">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="14" Foreground="#FFFFFF" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2-Column Split: Left (Pure Visual Art) & Right (Professional Login Card) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column is left pure & clean for the photographic poster art -->
                <Grid Grid.Column="0" />

                <!-- Right Column: Professional Floating Glass Card -->
                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,70,0">
                    <Border Width="420"
                            CornerRadius="20"
                            BorderThickness="1"
                            Padding="36,32,36,30">

                        <!-- Natural Soft Ambient Shadow (No tacky neon glow) -->
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="45" ShadowDepth="12" Opacity="0.6" Direction="270" />
                        </Border.Effect>

                        <!-- Subtle Translucent Specular Glass Border -->
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#40FFFFFF" Offset="0.0" />
                                <GradientStop Color="#18FFFFFF" Offset="0.5" />
                                <GradientStop Color="#3038BDF8" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>

                        <!-- Sophisticated Translucent Slate Glass Fill -->
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#900F172A" Offset="0.0" />
                                <GradientStop Color="#950B1322" Offset="0.5" />
                                <GradientStop Color="#A0060C16" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <StackPanel>
                            <!-- Card Header: Brand Logo & Title moved inside the card -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                                <!-- Soothing Ocean Cyan Frosted Glass Badge -->
                                <Border Width="58" Height="58"
                                        CornerRadius="18"
                                        BorderThickness="1.2"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,12">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#8038BDF8" Offset="0.0" />
                                            <GradientStop Color="#250284C7" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#300369A1" Offset="0.0" />
                                            <GradientStop Color="#180F172A" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0284C7" BlurRadius="14" ShadowDepth="2" Opacity="0.35" Direction="270" />
                                    </Border.Effect>

                                    <!-- Clean Vector Shopping Cart in Ice Sky White -->
                                    <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 1,2 L 4,2 L 6.8,14 C 6.95,14.6 7.45,15 8.1,15 L 18.5,15 C 19.15,15 19.65,14.6 19.8,14 L 22,5 L 5.2,5"
                                                  Stroke="#E0F2FE" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <Ellipse Canvas.Left="7.2" Canvas.Top="18" Width="2.8" Height="2.8" Fill="#E0F2FE" />
                                            <Ellipse Canvas.Left="17" Canvas.Top="18" Width="2.8" Height="2.8" Fill="#E0F2FE" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <!-- Brand Name -->
                                <TextBlock Text="KATQ SUPERMARKET"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3" />

                                <!-- Sub-tagline -->
                                <TextBlock Text="Hệ thống Bán lẻ &amp; Quản trị Siêu thị"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Subtle Elegant Divider -->
                            <Border Height="1" Background="#20FFFFFF" Margin="0,0,0,18" />

                            <!-- ─── BƯỚC 1: NHẬP TÀI KHOẢN & MẬT KHẨU ─── -->
                            <StackPanel x:Name="PnlStepCredentials" Visibility="Visible">
                                <!-- Section Title -->
                                <TextBlock Text="Đăng nhập tài khoản"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F0"
                                           Margin="2,0,0,14"
                                           RenderOptions.ClearTypeHint="Enabled"
                                           TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextRenderingMode="ClearType" />

                                <!-- Field: Tên đăng nhập -->
                                <Border x:Name="BorderUsername"
                                        CornerRadius="12" Height="46"
                                        Background="#251E293B"
                                        BorderThickness="1"
                                        BorderBrush="#334155"
                                        Margin="0,0,0,14"
                                        Padding="14,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Person20" FontSize="17" Foreground="#38BDF8" Margin="0,0,10,0" />
                                        <Grid Grid.Column="1">
                                            <TextBlock x:Name="PlaceholderUsername"
                                                       Text="Tên đăng nhập"
                                                       Foreground="#64748B"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False" />
                                            <TextBox x:Name="TxtUsername"
                                                     Style="{StaticResource ModernInputTextStyle}"
                                                     GotFocus="InputBox_GotFocus"
                                                     LostFocus="InputBox_LostFocus"
                                                     TextChanged="TxtUsername_TextChanged" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Field: Mật khẩu -->
                                <Border x:Name="BorderPassword"
                                        CornerRadius="12" Height="46"
                                        Background="#251E293B"
                                        BorderThickness="1"
                                        BorderBrush="#334155"
                                        Margin="0,0,0,18"
                                        Padding="14,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed20" FontSize="17" Foreground="#38BDF8" Margin="0,0,10,0" />
                                        <Grid Grid.Column="1">
                                            <TextBlock x:Name="PlaceholderPassword"
                                                       Text="Mật khẩu"
                                                       Foreground="#64748B"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False" />
                                            <PasswordBox x:Name="TxtPassword"
                                                         Style="{StaticResource ModernInputPasswordStyle}"
                                                         GotFocus="PasswordBox_GotFocus"
                                                         LostFocus="PasswordBox_LostFocus"
                                                         PasswordChanged="TxtPassword_PasswordChanged" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Status thông báo đăng nhập (ẩn khi không có lỗi) -->
                                <TextBlock x:Name="TxtLoginStatus" Text=""
                                           Visibility="Collapsed"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FB7185"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap" />

                                <!-- Action Button: ĐĂNG NHẬP (Compact & Balanced) -->
                                <Button x:Name="BtnLogin"
                                        HorizontalAlignment="Stretch"
                                        Height="42"
                                        Margin="0,0,0,14"
                                        Click="BtnLogin_Click"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    CornerRadius="12"
                                                    BorderThickness="1"
                                                    BorderBrush="#60BAE6FD">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#0284C7" Offset="0.0" />
                                                        <GradientStop Color="#0EA5E9" Offset="0.5" />
                                                        <GradientStop Color="#38BDF8" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#0284C7" BlurRadius="14" ShadowDepth="2" Opacity="0.4" Direction="270" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#0EA5E9" Offset="0.0" />
                                                                <GradientStop Color="#38BDF8" Offset="0.5" />
                                                                <GradientStop Color="#7DD3FC" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#A0E0F2FE" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.88" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="ĐĂNG NHẬP"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                </Button>

                                <!-- Footer Links -->
                                <Grid Margin="2,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Quên mật khẩu?"
                                               FontSize="12"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Left"
                                               Cursor="Hand"
                                               MouseDown="LinkForgotPassword_Click">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#38BDF8" />
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1"
                                               Text="Hỗ trợ kỹ thuật"
                                               FontSize="12"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Right"
                                               Cursor="Hand"
                                               MouseDown="LinkNeedHelp_Click">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#38BDF8" />
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!-- ─── BƯỚC 2: KHUNG NHẬP MÃ PIN (6 SỐ & BÀN PHÍM NUMPAD) ─── -->
                            <StackPanel x:Name="PnlStepPin" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="Xác nhận mã PIN ca trực"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtPinPrompt" Text="Nhập 6 số PIN để vào phiên làm việc"
                                               FontSize="12" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- 6 Ô số PIN ở trên -->
                                <UniformGrid Columns="6" Width="336" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Border x:Name="BoxPin0" Width="46" Height="52" Background="#251E293B" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="10" Margin="4">
                                        <TextBlock x:Name="PinDigit0" Text="" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BoxPin1" Width="46" Height="52" Background="#251E293B" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="10" Margin="4">
                                        <TextBlock x:Name="PinDigit1" Text="" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BoxPin2" Width="46" Height="52" Background="#251E293B" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="10" Margin="4">
                                        <TextBlock x:Name="PinDigit2" Text="" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BoxPin3" Width="46" Height="52" Background="#251E293B" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="10" Margin="4">
                                        <TextBlock x:Name="PinDigit3" Text="" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BoxPin4" Width="46" Height="52" Background="#251E293B" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="10" Margin="4">
                                        <TextBlock x:Name="PinDigit4" Text="" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BoxPin5" Width="46" Height="52" Background="#251E293B" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="10" Margin="4">
                                        <TextBlock x:Name="PinDigit5" Text="" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>

                                <!-- Bàn phím số Numpad ở dưới -->
                                <Grid Width="336" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Hàng 1: 1 2 3 -->
                                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="1"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="2"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="3"/>

                                    <!-- Hàng 2: 4 5 6 -->
                                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="4"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="5"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="6"/>

                                    <!-- Hàng 3: 7 8 9 -->
                                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="7"/>
                                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="8"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="9"/>

                                    <!-- Hàng 4: ⌫ Xóa, 0, ✕ Quay lại -->
                                    <Button Grid.Row="3" Grid.Column="0" Content="⌫ Xóa" Style="{StaticResource PinKeyBtn}" FontSize="12" Click="BtnPinDel_Click" ToolTip="Xóa 1 số"/>
                                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource PinKeyBtn}" Click="BtnPinNum_Click" Tag="0"/>
                                    <Button Grid.Row="3" Grid.Column="2" Content="✕ Quay lại" Style="{StaticResource PinKeyBtn}" FontSize="11" Foreground="#94A3B8" Click="BtnPinBack_Click" ToolTip="Quay lại đổi tài khoản"/>
                                </Grid>

                                <!-- Status thông báo kết quả mã PIN (Đăng nhập thành công ✓) -->
                                <TextBlock x:Name="TxtPinStatus" Text=""
                                           Visibility="Collapsed"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#4ADE80"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,2"
                                           TextWrapping="Wrap" />

                                <!-- Nút Xác Nhận PIN -->
                                <Button x:Name="BtnConfirmPin"
                                        FocusVisualStyle="{x:Null}"
                                        HorizontalAlignment="Stretch"
                                        Height="42"
                                        Margin="0,12,0,0"
                                        Click="BtnConfirmPin_Click"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" CornerRadius="10" BorderThickness="1" BorderBrush="#60BAE6FD">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#0284C7" Offset="0.0" />
                                                        <GradientStop Color="#0EA5E9" Offset="0.5" />
                                                        <GradientStop Color="#38BDF8" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#0284C7" BlurRadius="14" ShadowDepth="2" Opacity="0.4" Direction="270" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#0EA5E9" Offset="0.0" />
                                                                <GradientStop Color="#38BDF8" Offset="0.5" />
                                                                <GradientStop Color="#7DD3FC" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.88" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="XÁC NHẬN" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>