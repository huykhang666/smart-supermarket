<ui:FluentWindow x:Class="SmartSupermarket.POS.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Đăng Nhập • KATQ Smart Supermarket"
        Height="640" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="KATQ Workstation Authentication" />

        <!-- Centered Login Card Container -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:Card Width="390" Padding="28" Margin="10">
                <StackPanel>
                    <!-- Brand Logo & Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border Width="64" Height="64" CornerRadius="16" Background="#EFF6FF" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="32" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="KATQ SUPERMARKET" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,2" />
                        <TextBlock Text="Đăng Nhập Trạm Làm Việc POS &amp; ERP" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Username Field -->
                    <TextBlock Text="Tên đăng nhập:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="TxtUsername" PlaceholderText="Nhập tài khoản (admin / nhanvien)..."
                                Height="38" Margin="0,0,0,14" Text="admin"
                                Icon="{ui:SymbolIcon Person24}" />

                    <!-- Password Field -->
                    <TextBlock Text="Mật khẩu:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="TxtPassword" Password="admin123"
                                    Height="38" Margin="0,0,0,14" />

                    <!-- Quick Credentials Chips -->
                    <TextBlock Text="Điền nhanh tài khoản mẫu:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <ui:Button Content="👑 Quản Trị (Admin)" Margin="0,0,4,0" Height="30" FontSize="11"
                                   Click="BtnQuickAdmin_Click" />
                        <ui:Button Content="🛒 Thu Ngân (Staff)" Margin="4,0,0,0" Height="30" FontSize="11"
                                   Click="BtnQuickStaff_Click" />
                    </UniformGrid>

                    <!-- Alert / Status Text -->
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="11.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <!-- Login Button -->
                    <ui:Button x:Name="BtnLogin" Appearance="Primary" Height="42" HorizontalAlignment="Stretch"
                               Click="BtnLogin_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowRight24" Margin="0,0,8,0" />
                            <TextBlock Text="ĐĂNG NHẬP VÀO HỆ THỐNG" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Server Connection Footer -->
                    <Border Margin="0,18,0,0" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="🟢 Máy chủ API: http://localhost:5137 (Sẵn sàng)"
                                   FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
