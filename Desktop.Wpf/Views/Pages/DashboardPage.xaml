<Page x:Class="SmartSupermarket.POS.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header Banner -->
            <ui:Card Margin="0,0,0,20" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="KATQ SUPERMARKET SMART ERP"
                                   FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Trung tâm điều hành doanh thu thời gian thực, quản lý điểm bán POS &amp; tồn kho"
                                   Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Content="Làm mới dữ liệu" Click="BtnRefresh_Click" />
                </Grid>
            </ui:Card>

            <!-- 4 Modern Metric KPI Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Card 1 -->
                <ui:Card Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="DOANH THU HÔM NAY" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="Money24" HorizontalAlignment="Right" Foreground="#2563EB" />
                        </Grid>
                        <TextBlock x:Name="TxtTodayRevenue" Text="12,450,000 đ" FontSize="20" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="▲ +14.2% so với hôm qua" FontSize="11" Foreground="#059669" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Card>

                <!-- Card 2 -->
                <ui:Card Margin="5,0,5,0" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TỔNG ĐƠN HÀNG POS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="Cart24" HorizontalAlignment="Right" Foreground="#059669" />
                        </Grid>
                        <TextBlock x:Name="TxtTodayOrders" Text="84 đơn" FontSize="20" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="✓ 100% hoàn thành tại quầy" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:Card>

                <!-- Card 3 -->
                <ui:Card Margin="5,0,5,0" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="KHÁCH HÀNG THÀNH VIÊN" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="People24" HorizontalAlignment="Right" Foreground="#D97706" />
                        </Grid>
                        <TextBlock x:Name="TxtCustomers" Text="1,248 TV" FontSize="20" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="★ 32 thẻ VIP hạng Vàng" FontSize="11" Foreground="#D97706" />
                    </StackPanel>
                </ui:Card>

                <!-- Card 4 -->
                <ui:Card Margin="10,0,0,0" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CẢNH BÁO TỒN KHO &amp; HSD" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="Warning24" HorizontalAlignment="Right" Foreground="#DC2626" />
                        </Grid>
                        <TextBlock x:Name="TxtWarnings" Text="3 sản phẩm" FontSize="20" FontWeight="Bold" Margin="0,8,0,4" Foreground="#DC2626" />
                        <TextBlock Text="⏳ Cần xả hàng cận date" FontSize="11" Foreground="#DC2626" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Recent Orders Section -->
            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="LỊCH SỬ GIAO DỊCH GẦN NHẤT" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />
                    
                    <DataGrid x:Name="DgvRecentOrders" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="38" FontSize="13" CanUserResizeRows="False"
                              BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MÃ ĐƠN" Binding="{Binding OrderCode}" Width="120" />
                    <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding CustomerName}" Width="160" />
                    <DataGridTextColumn Header="THU NGÂN" Binding="{Binding EmployeeName}" Width="130" />
                    <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding FormattedDate}" Width="150" />
                    <DataGridTextColumn Header="PHƯƠNG THỨC" Binding="{Binding PaymentMethod}" Width="130" />
                    <DataGridTextColumn Header="THÀNH TIỀN" Binding="{Binding FormattedFinalAmount}" Width="*" />
                </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
