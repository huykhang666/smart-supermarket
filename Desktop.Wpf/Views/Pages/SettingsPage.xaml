<Page x:Class="SmartSupermarket.POS.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Cài Đặt Hệ Thống"
      Background="{StaticResource AppBackgroundBrush}"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextHintingMode="Fixed"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      FontFamily="Segoe UI, Inter, Arial">

    <Page.Resources>
        <!-- Standard Settings Card -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <!-- Card Icon Container Badge (Harmonized Technology Blue) -->
        <Style x:Key="CardIconBadge" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource Primary100Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Primary200Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Theme Segment Button: Active (Vibrant Technology Blue) -->
        <Style x:Key="ThemeSegmentBtnActive" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource Primary600Brush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Primary700Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Primary800Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme Segment Button: Inactive (Clean White Neutral) -->
        <Style x:Key="ThemeSegmentBtnInactive" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Primary50Brush}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Primary600Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primary600Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Primary100Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outline Action Button (In Thử, Kiểm Tra Kết Nối) -->
        <Style x:Key="SettingsActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Primary600Brush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Primary50Brush}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Primary600Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Primary100Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Reset Button (Khôi phục mặc định) -->
        <Style x:Key="ResetActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FEF2F2"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#FECACA"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Save Button -->
        <Style x:Key="SaveConfigBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Background" Value="{StaticResource Primary600Brush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Primary700Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Primary800Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Margin="24,20,24,28">

            <!-- ════ 0. Tiêu Đề Trang Gọn Gàng ════ -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Cài Đặt Hệ Thống" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Cấu hình thiết bị, giao diện và tùy chọn thanh toán tại quầy"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- ════ 1. THẺ THÔNG TIN NHÂN VIÊN & CA TRỰC ════ -->
            <Border Style="{StaticResource SettingsCard}" BorderBrush="{StaticResource Primary200Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Icon -->
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                            Background="{StaticResource Primary600Brush}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="A" FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Staff Profile Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock x:Name="TxtStaffName" Text="Nhân Viên Thu Ngân" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="{StaticResource Primary100Brush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Thu Ngân" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Primary600Brush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="@" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtStaffUsername" Text="nhanvien" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="  •  Ca Sáng (07:00 – 14:30)  •  Quầy POS #01" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Active Shift Status Badge -->
                    <Border Grid.Column="2" Background="{StaticResource SuccessBgBrush}" BorderBrush="#A7F3D0" BorderThickness="1"
                            CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="Đang trong ca trực" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ════ 2. CHẾ ĐỘ GIAO DIỆN MÀU SẮC ════ -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardIconBadge}">
                            <ui:SymbolIcon Symbol="DarkTheme24" FontSize="18" Foreground="{StaticResource Primary600Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Chế Độ Giao Diện" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Lựa chọn giao diện hiển thị phù hợp với điều kiện ánh sáng quầy"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal">
                        <!-- Nút Sáng: Active -->
                        <Button Style="{StaticResource ThemeSegmentBtnActive}" Click="BtnThemeLight_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Giao diện Sáng" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextRenderingMode="Grayscale"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Tối: Inactive -->
                        <Button Style="{StaticResource ThemeSegmentBtnInactive}" Click="BtnThemeDark_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Giao diện Tối" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextRenderingMode="ClearType"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════ 3. CẤU HÌNH MÁY IN HÓA ĐƠN K80 ════ -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardIconBadge}">
                            <ui:SymbolIcon Symbol="Print24" FontSize="18" Foreground="{StaticResource Primary600Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Máy In Hóa Đơn (K80)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Cấu hình kết nối máy in nhiệt và kiểm tra lệnh in hóa đơn"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <!-- Chọn máy in -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Máy in hóa đơn mặc định:" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="8" Height="40">
                                <ComboBox Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                          FontSize="13" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="12,0">
                                    <ComboBoxItem Content="EPSON TM-T82X (USB / LAN)" IsSelected="True"/>
                                    <ComboBoxItem Content="Xprinter XP-Q800 (USB)"/>
                                    <ComboBoxItem Content="BIXOLON SRP-350 Plus"/>
                                    <ComboBoxItem Content="Microsoft Print to PDF"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <!-- Khổ giấy in -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Khổ giấy in nhiệt:" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="8" Height="40">
                                <ComboBox Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                          FontSize="13" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="12,0">
                                    <ComboBoxItem Content="K80 – 80mm (Chuẩn siêu thị)" IsSelected="True"/>
                                    <ComboBoxItem Content="K57 – 57mm (Mini)"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Trạng thái kết nối & Nút in thử -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Máy in sẵn sàng kết nối cổng USB-01" FontSize="12.5" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Nút In Thử Hóa Đơn -->
                        <Button Grid.Column="1" Style="{StaticResource SettingsActionBtn}" Click="BtnPrintTest_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Print20" FontSize="15" Foreground="{StaticResource Primary600Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="In Thử Hóa Đơn" Foreground="{StaticResource Primary600Brush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ════ 4. TÙY CHỌN THAO TÁC BÁN HÀNG TẠI QUẦY ════ -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardIconBadge}">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="{StaticResource Primary600Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tùy Chọn Thao Tác" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Cấu hình âm thanh phản hồi và tự động hóa thao tác quầy thu ngân"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <StackPanel>
                        <CheckBox IsChecked="True" Margin="0,0,0,12" Cursor="Hand">
                            <TextBlock Text="Phát âm thanh 'Bíp' khi quét mã vạch sản phẩm thành công" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </CheckBox>

                        <CheckBox IsChecked="True" Margin="0,0,0,12" Cursor="Hand">
                            <TextBlock Text="Tự động mở ngăn kéo đựng tiền khi xác nhận thanh toán Tiền mặt" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </CheckBox>

                        <CheckBox IsChecked="True" Cursor="Hand">
                            <TextBlock Text="Tự động in hóa đơn ngay sau khi hoàn tất đơn hàng" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════ 5. TRẠNG THÁI KẾT NỐI MÁY CHỦ API ════ -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardIconBadge}">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="18" Foreground="{StaticResource Primary600Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Kết Nối Máy Chủ (API)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Đồng bộ danh mục hàng hóa, giá niêm yết và dữ liệu theo thời gian thực"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thông tin kết nối -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Máy chủ hoạt động bình thường" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="Độ trễ: 38ms" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Địa chỉ dịch vụ: http://localhost:5000/api/" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Nút Kiểm Tra Kết Nối -->
                        <Button Grid.Column="1" Style="{StaticResource SettingsActionBtn}" Click="BtnCheckApi_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync20" FontSize="15" Foreground="{StaticResource Primary600Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kiểm Tra Kết Nối" Foreground="{StaticResource Primary600Brush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ════ 6. THANH HÀNH ĐỘNG CUỐI TRANG (CÂN ĐỐI 2 BÊN) ════ -->
            <Grid Margin="0,4,0,12">
                <!-- Nút phụ bên trái: Khôi phục mặc định -->
                <Button HorizontalAlignment="Left" Style="{StaticResource ResetActionBtn}" Click="BtnRestoreDefaults_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowCounterclockwise20" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Khôi Phục Mặc Định" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Nút chính bên phải: Lưu thiết lập -->
                <Button HorizontalAlignment="Right" Style="{StaticResource SaveConfigBtn}" Click="BtnSaveConfig_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Save24" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lưu Thiết Lập" Foreground="White" FontSize="13.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="Grayscale"/>
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
