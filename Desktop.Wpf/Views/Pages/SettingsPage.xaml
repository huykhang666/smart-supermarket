<Page x:Class="SmartSupermarket.POS.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Cài Đặt">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="CÀI ĐẶT HỆ THỐNG &amp; GIAO DIỆN" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- Theme Card -->
            <ui:Card Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Giao diện &amp; Chủ đề (Theme)" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="Tùy chọn phong cách hiển thị Windows 11 Fluent Design"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Sáng (Light Mode)" Margin="0,0,8,0" Click="BtnThemeLight_Click" />
                        <ui:Button Content="Tối (Dark Mode)" Margin="0,0,8,0" Click="BtnThemeDark_Click" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- API Connection Card -->
            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="Kết Nối Máy Chủ API Backend" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="Địa chỉ máy chủ ASP.NET Core Web API của siêu thị"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,12" />

                    <TextBlock Text="URL Endpoint:" FontSize="13" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="TxtApiUrl" Text="http://localhost:5137" Height="36" Margin="0,0,0,12" />
                    <ui:Button Appearance="Primary" Content="Lưu Cấu Hình" Click="BtnSaveConfig_Click" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
