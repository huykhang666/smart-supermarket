<Page x:Class="SmartSupermarket.POS.Views.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Quản Lý Kho Hàng"
      Background="{StaticResource AppBackgroundBrush}"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextHintingMode="Fixed"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      FontFamily="Segoe UI, Inter, Arial">

    <Page.Resources>
        <!-- Light DataGrid Styles matching Technology Blue -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7FD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Primary100Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource Primary800Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- 4 HSD Metric Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Toolbar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0: Header & Action Buttons ══ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Quản Lý Kho Hàng &amp; Hạn Sử Dụng Động" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Theo dõi định mức tồn kho an toàn, cảnh báo cận date và tra cứu mã vạch"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút Làm mới -->
                    <Button Style="{StaticResource TechPrimaryBtn}" Margin="0,0,8,0" Click="BtnRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Làm Mới" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Lập Đơn Nhập Kho -->
                    <Button Style="{StaticResource TechSecondaryBtn}" Margin="0,0,8,0" Click="BtnCreateImportOrder_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Foreground="{StaticResource Primary600Brush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Nhập hàng"/>
                        </StackPanel>
                    </Button>

                    <!-- Xuất Báo Cáo HSD -->
                    <Button Style="{StaticResource TechSecondaryBtn}" Click="BtnExportExpiryReport_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Document24" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Xuất file kho"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 1: 4 Metric Cards (Theo dõi HSD & Định mức) ══ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="20,16,20,10">
            <!-- Card 1: Hết Hạn Nguy Hiểm -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="HẾT HẠN TRONG NGÀY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="18" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtExpiredCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text=" sản phẩm" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="Khóa mã bán tự động (An toàn) ✓" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Cận Date 30 Ngày -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#FED7AA" BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="4,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="CẬN DATE (&lt; 30 NGÀY)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                        <ui:SymbolIcon Symbol="Warning24" FontSize="18" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtNearExpiryCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text=" sản phẩm" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="Giảm giá xả hàng khuyến nghị" FontSize="11" Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Cảnh Báo Tồn Kho Dưới Định Mức -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="4,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="SẮP HẾT HÀNG (&lt; 10 SP)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                        <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="18" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtLowStockCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text=" mặt hàng" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="Cần lập lệnh nhập hàng ngay →" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Tổng Tồn Kho An Toàn -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="8,0,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="TỔNG MẶT HÀNG KHO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Primary600Brush}"/>
                        <ui:SymbolIcon Symbol="Calendar24" FontSize="18" Foreground="{StaticResource Primary600Brush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtTotalProductsCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Primary600Brush}"/>
                        <TextBlock Text=" mã SKU" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="Dữ liệu đồng bộ máy chủ CSDL ✓" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ══ ROW 2: Filter Toolbar ══ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Grid.Column="0" Style="{StaticResource ModernInputContainer}" Height="38" Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="16" Foreground="{StaticResource Primary600Brush}" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch"
                                 Style="{StaticResource CleanGhostTextBox}"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock Grid.Column="1" Text="Tra cứu theo tên SP, Barcode..."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TxtSearch, Path=Text}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Category Dropdown -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="8" Height="38" Padding="8,0">
                    <ComboBox x:Name="CbCategory"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CbCategory_SelectionChanged">
                        <ComboBoxItem Content="Tất cả danh mục" IsSelected="True"/>
                        <ComboBoxItem Content="Nước giải khát &amp; Đồ uống"/>
                        <ComboBoxItem Content="Sữa &amp; Các sản phẩm từ sữa"/>
                        <ComboBoxItem Content="Bánh kẹo &amp; Ăn vặt"/>
                        <ComboBoxItem Content="Mì, Miến &amp; Thực phẩm ăn liền"/>
                        <ComboBoxItem Content="Gia vị &amp; Dầu ăn"/>
                        <ComboBoxItem Content="Hóa phẩm &amp; Tẩy rửa"/>
                        <ComboBoxItem Content="Chăm sóc cá nhân &amp; Gia đình"/>
                        <ComboBoxItem Content="Thực phẩm khô &amp; Đóng hộp"/>
                        <ComboBoxItem Content="Đồ gia dụng tiện ích"/>
                    </ComboBox>
                </Border>
            </Grid>
        </Border>

        <!-- ══ ROW 3: Products DataGrid ══ -->
        <DataGrid Grid.Row="3" x:Name="DgvProducts" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  RowHeight="46" FontSize="13" BorderThickness="0" Background="Transparent"
                  SelectionUnit="FullRow" IsReadOnly="True" Margin="20,8,20,8">
            <DataGrid.Columns>
                <!-- Barcode: Centered, Proportional -->
                <DataGridTextColumn Header="MÃ VẠCH (BARCODE)" Binding="{Binding Barcode}" Width="1.4*" MinWidth="130"
                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource Primary600Brush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Product Name: Left Aligned, Largest Content Column (32% table space) -->
                <DataGridTextColumn Header="TÊN HÀNG HÓA" Binding="{Binding ProductName}" Width="3.2*" MinWidth="260">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Category: Left Aligned, Natural Width (15% table space) -->
                <DataGridTextColumn Header="DANH MỤC" Binding="{Binding CategoryName}" Width="1.5*" MinWidth="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Price: Centered, Proportional (13% table space) -->
                <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding FormattedPrice}" Width="1.3*" MinWidth="110"
                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{StaticResource Primary600Brush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Stock: Centered, Proportional (13% table space) -->
                <DataGridTextColumn Header="TỒN KHO" Binding="{Binding FormattedStock}" Width="1.3*" MinWidth="110"
                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status Badge: Centered, Proportional (13% table space) -->
                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.3*" MinWidth="110"
                                        HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="#A7F3D0" BorderThickness="1"
                                    CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                                <TextBlock Text="Còn hàng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
