<Page x:Class="SmartSupermarket.POS.Views.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Lịch Sử Đơn Hàng"
      Background="{StaticResource AppBackgroundBrush}"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextHintingMode="Fixed"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      FontFamily="Segoe UI, Inter, Arial">

    <Page.Resources>
        <!-- Date Filter Chip Button -->
        <Style x:Key="DateFilterChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Primary600Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primary600Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light DataGrid Styles matching Technology Blue -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7FD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Primary100Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource Primary800Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Bar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0: Page Title & Toolbar ══ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Page Header Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Đơn Hàng &amp; Tra Cứu Quầy Thu Ngân" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Quản lý lịch sử giao dịch POS, đối soát thanh toán và in lại hóa đơn"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Quick Action Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Làm Mới -->
                    <Button Style="{StaticResource TechPrimaryBtn}" Margin="0,0,8,0" Click="BtnRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Làm mới" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Xem Chi Tiết -->
                    <Button Style="{StaticResource TechSecondaryBtn}" Margin="0,0,8,0" Click="BtnViewDetail_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{StaticResource Primary600Brush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Xem chi tiết"/>
                        </StackPanel>
                    </Button>

                    <!-- In Lại Hóa Đơn (K80) -->
                    <Button Style="{StaticResource TechSecondaryBtn}" Margin="0,0,8,0" Click="BtnPrintReceipt_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Print24" FontSize="14" Foreground="{StaticResource Primary600Brush}" Margin="0,0,6,0"/>
                            <TextBlock Text="In lại hóa đơn"/>
                        </StackPanel>
                    </Button>

                    <!-- Xuất Excel / CSV -->
                    <Button Style="{StaticResource TechSecondaryBtn}" Margin="0,0,8,0" Click="BtnExportExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Document24" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Xuất Excel"/>
                        </StackPanel>
                    </Button>

                    <!-- Hủy Đơn -->
                    <Button Style="{StaticResource TechDangerBtn}" Click="BtnCancelOrder_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Hủy đơn"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 1: Filter Bar ══ -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Grid.Column="0" Style="{StaticResource ModernInputContainer}" Height="38" Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="14" Foreground="{StaticResource Primary600Brush}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearchOrder"
                                 Style="{StaticResource CleanGhostTextBox}"
                                 TextChanged="TxtSearchOrder_TextChanged"/>
                        <TextBlock Grid.Column="1" Text="Tìm mã đơn, tên thu ngân, khách..."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TxtSearchOrder, Path=Text}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Status Filter Dropdown -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="8" Height="38" Padding="8,0">
                    <ComboBox x:Name="CbStatusFilter"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CbStatusFilter_SelectionChanged">
                        <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/>
                        <ComboBoxItem Content="Hoàn thành"/>
                        <ComboBoxItem Content="Đã hủy"/>
                    </ComboBox>
                </Border>

                <!-- Date Range Quick Chips -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DateFilterChip}" Content="Hôm Nay" Margin="0,0,6,0" Click="BtnFilterToday_Click"/>
                    <Button Style="{StaticResource DateFilterChip}" Content="7 Ngày Qua" Margin="0,0,6,0" Click="BtnFilterWeek_Click"/>
                    <Button Style="{StaticResource DateFilterChip}" Content="Tất Cả" Click="BtnFilterAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 2: Orders DataGrid ══ -->
        <DataGrid Grid.Row="2" x:Name="DgvOrders" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  RowHeight="46" FontSize="13" BorderThickness="0" Background="Transparent"
                  SelectionUnit="FullRow" IsReadOnly="True"
                  MouseDoubleClick="DgvOrders_MouseDoubleClick" Margin="20,8,20,8">
            <DataGrid.Columns>
                <!-- Order Code: Centered, Proportional -->
                <DataGridTextColumn Header="MÃ ĐƠN" Binding="{Binding OrderCode}" Width="1.1*" MinWidth="110"
                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource Primary600Brush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Order Date: Centered, Proportional -->
                <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding FormattedDate}" Width="1.4*" MinWidth="140"
                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Cashier: Left Aligned, Largest Text Column (25% table space) -->
                <DataGridTextColumn Header="THU NGÂN" Binding="{Binding EmployeeName}" Width="2.5*" MinWidth="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Customer: Centered, Proportional -->
                <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding CustomerName}" Width="1.4*" MinWidth="130"
                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Payment Method: Centered, Proportional -->
                <DataGridTextColumn Header="PHƯƠNG THỨC" Binding="{Binding PaymentMethod}" Width="1.2*" MinWidth="110"
                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Final Amount: Centered with bold font, Proportional -->
                <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding FormattedFinalAmount}" Width="1.3*" MinWidth="120"
                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{StaticResource Primary700Brush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status Badge: Centered, Proportional -->
                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.1*" MinWidth="110"
                                        HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Đã hủy">
                                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Đã hủy">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ══ ROW 3: Footer Summary ══ -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="TxtOrderCountSummary" Text="Hiển thị: 0 đơn hàng"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalRevenueSummary" Text="Tổng thực thu: 0 đ"
                           Foreground="{StaticResource Primary600Brush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
