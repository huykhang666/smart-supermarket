<Page x:Class="SmartSupermarket.POS.Views.Pages.PosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="POS Bán Hàng">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Product Catalog Grid -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <ui:TextBox Grid.Row="0" x:Name="TxtSearch" PlaceholderText="🔍 Quét mã vạch hoặc gõ tên sản phẩm..."
                        Margin="0,0,0,10" Height="40" FontSize="14" TextChanged="TxtSearch_TextChanged"
                        ClearButtonEnabled="True" />

            <!-- Category Filter Horizontal Strip -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Tất cả" Margin="0,0,6,0" Appearance="Primary" Click="CategoryBtn_Click" Tag="" />
                    <ui:Button Content="Nước giải khát" Margin="0,0,6,0" Appearance="Secondary" Click="CategoryBtn_Click" Tag="Nước giải khát" />
                    <ui:Button Content="Sữa &amp; Sản phẩm sữa" Margin="0,0,6,0" Appearance="Secondary" Click="CategoryBtn_Click" Tag="Sữa" />
                    <ui:Button Content="Bánh kẹo &amp; Ăn vặt" Margin="0,0,6,0" Appearance="Secondary" Click="CategoryBtn_Click" Tag="Bánh kẹo" />
                    <ui:Button Content="Gia vị &amp; Đồ khô" Margin="0,0,6,0" Appearance="Secondary" Click="CategoryBtn_Click" Tag="Gia vị" />
                    <ui:Button Content="Đồ ăn liền" Margin="0,0,6,0" Appearance="Secondary" Click="CategoryBtn_Click" Tag="Đồ ăn liền" />
                </StackPanel>
            </ScrollViewer>

            <!-- Product Cards WrapPanel -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IcProducts">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardAction Margin="6" Width="185" Height="255" Padding="10" Click="ProductCard_Click" Tag="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="125" />
                                        <RowDefinition Height="45" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="24" />
                                    </Grid.RowDefinitions>

                                    <!-- Product Image -->
                                    <Border Grid.Row="0" CornerRadius="6" Background="#F1F5F9" ClipToBounds="True">
                                        <Image Source="{Binding ImageUrl}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Product Name -->
                                    <TextBlock Grid.Row="1" Text="{Binding ProductName}" TextWrapping="Wrap" Height="36"
                                               FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Price -->
                                    <TextBlock Grid.Row="2" Text="{Binding FormattedPrice}"
                                               FontSize="14" FontWeight="Bold" Foreground="#2563EB"
                                               VerticalAlignment="Center" />

                                    <!-- Stock & Barcode -->
                                    <Grid Grid.Row="3">
                                        <TextBlock Text="{Binding FormattedStock}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="🛒 Thêm" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#059669" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </ui:CardAction>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- RIGHT COLUMN: Cart & Checkout -->
        <ui:Card Grid.Column="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cart Header & Customer lookup -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="GIỎ HÀNG THU NGÂN" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <ui:Button Content="Xóa hết" Appearance="Transparent" HorizontalAlignment="Right" Click="BtnClearCart_Click" />
                    </Grid>

                    <ui:TextBox x:Name="TxtCustomerPhone" PlaceholderText="Nhập SĐT khách hàng tích điểm..."
                                Margin="0,0,0,4" Height="36" />
                    <TextBlock x:Name="TxtCustomerLoyaltyInfo" Text="Khách Lẻ • Điểm tích lũy: 0"
                               FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Cart Items List -->
                <DataGrid Grid.Row="1" x:Name="DgCart" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeight="42" FontSize="12.5" BorderThickness="0" Background="Transparent"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mặt Hàng" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTemplateColumn Header="SL" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:Button Content="-" Width="22" Height="22" Padding="0" Click="BtnDecQty_Click" Tag="{Binding}" />
                                        <TextBlock Text="{Binding Quantity}" Width="24" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                        <ui:Button Content="+" Width="22" Height="22" Padding="0" Click="BtnIncQty_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Thành Tiền" Binding="{Binding FormattedTotal}" Width="85" />
                        <DataGridTemplateColumn Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Icon="{ui:SymbolIcon Delete20}" Appearance="Transparent"
                                               Width="28" Height="28" Padding="0" Click="BtnRemoveItem_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Billing & Checkout Action Panel -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Separator Margin="0,0,0,10" />

                    <!-- Calculation lines -->
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Tạm tính:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TxtSubTotal" Text="0 đ" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <TextBlock Text="Giảm giá / Voucher:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TxtDiscount" Text="0 đ" HorizontalAlignment="Right" Foreground="#059669" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,4,0,12">
                        <TextBlock Text="TỔNG THANH TOÁN:" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtGrandTotal" Text="0 đ" HorizontalAlignment="Right"
                                   FontSize="20" FontWeight="Bold" Foreground="#2563EB" />
                    </Grid>

                    <!-- Large Checkout Action Buttons -->
                    <UniformGrid Columns="2">
                        <ui:Button Appearance="Primary" Height="44" Margin="0,0,4,0" Click="BtnPayQr_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="QrCode24" Margin="0,0,6,0" />
                                <TextBlock Text="VietQR Code" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Appearance="Secondary" Height="44" Margin="4,0,0,0" Click="BtnPayCash_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Money24" Margin="0,0,6,0" />
                                <TextBlock Text="Tiền Mặt" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
