<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Primary Colors – Technology Blue ══ -->
    <Color x:Key="Primary900">#063B73</Color>
    <Color x:Key="Primary800">#0756A5</Color>
    <Color x:Key="Primary700">#096BB8</Color>
    <Color x:Key="Primary600">#0284C7</Color>
    <Color x:Key="Primary500">#0EA5E9</Color>
    <Color x:Key="Primary400">#38BDF8</Color>
    <Color x:Key="Primary300">#7DD3FC</Color>
    <Color x:Key="Primary200">#BAE6FD</Color>
    <Color x:Key="Primary100">#E0F2FE</Color>
    <Color x:Key="Primary50">#F0F9FF</Color>

    <!-- ══ Neutral Colors – Clean High Contrast ══ -->
    <Color x:Key="AppBackground">#F4F7FB</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceSecondary">#F8FAFC</Color>
    <Color x:Key="Border">#E2E8F0</Color>
    <Color x:Key="BorderStrong">#CBD5E1</Color>
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="Disabled">#94A3B8</Color>

    <!-- ══ Semantic Colors ══ -->
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="SuccessBg">#ECFDF5</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="WarningBg">#FFFBEB</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerBg">#FEF2F2</Color>
    <Color x:Key="Info">#0284C7</Color>
    <Color x:Key="InfoBg">#E0F2FE</Color>

    <!-- ══ Brushes ══ -->
    <SolidColorBrush x:Key="Primary900Brush" Color="{StaticResource Primary900}"/>
    <SolidColorBrush x:Key="Primary800Brush" Color="{StaticResource Primary800}"/>
    <SolidColorBrush x:Key="Primary700Brush" Color="{StaticResource Primary700}"/>
    <SolidColorBrush x:Key="Primary600Brush" Color="{StaticResource Primary600}"/>
    <SolidColorBrush x:Key="Primary500Brush" Color="{StaticResource Primary500}"/>
    <SolidColorBrush x:Key="Primary400Brush" Color="{StaticResource Primary400}"/>
    <SolidColorBrush x:Key="Primary300Brush" Color="{StaticResource Primary300}"/>
    <SolidColorBrush x:Key="Primary200Brush" Color="{StaticResource Primary200}"/>
    <SolidColorBrush x:Key="Primary100Brush" Color="{StaticResource Primary100}"/>
    <SolidColorBrush x:Key="Primary50Brush" Color="{StaticResource Primary50}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary600}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource Primary800}"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondary}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBg}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBg}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBg}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBg}"/>

</ResourceDictionary>
