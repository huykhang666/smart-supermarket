classDiagram
    class AIController {
        -IAgentOrchestrator _orchestrator
        +ChatAsync(request) Task~IActionResult~
    }

    class IAgentOrchestrator {
        <<interface>>
        +DispatchAsync(userMessage, history) Task~ChatResponseDTO~
    }

    class AgentOrchestrator {
        -IShoppingAgent _shoppingAgent
        -IInventoryAgent _inventoryAgent
        -IPromotionAgent _promotionAgent
        -IRecipeAgent _recipeAgent
        -IBudgetAgent _budgetAgent
        -ICartAgent _cartAgent
        +DispatchAsync(userMessage, history) Task~ChatResponseDTO~
        -AnalyzeIntent(message) AgentIntent
    }

    class IShoppingAgent {
        <<interface>>
        +PlanShoppingAsync(intent, history) Task~ShoppingPlanResult~
    }

    class ShoppingAgent {
        -IRecipeAgent _recipeAgent
        -IInventoryAgent _inventoryAgent
        -IPromotionAgent _promotionAgent
        -IBudgetAgent _budgetAgent
        +PlanShoppingAsync(intent, history) Task~ShoppingPlanResult~
    }

    class IInventoryAgent {
        <<interface>>
        +CheckStockAsync(items) Task~InventoryStatusResult~
        +GetNearExpiryAsync(daysThreshold) Task~List~NearExpiryItem~~
    }

    class InventoryAgent {
        -InventoryTool _inventoryTool
        +CheckStockAsync(items) Task~InventoryStatusResult~
    }

    class IPromotionAgent {
        <<interface>>
        +GetDiscountsAsync(items) Task~List~DiscountResult~~
    }

    class PromotionAgent {
        -PromotionTool _promotionTool
        +GetDiscountsAsync(items) Task~List~DiscountResult~~
    }

    class IRecipeAgent {
        <<interface>>
        +FindRecipeIngredientsAsync(dishName, servings) Task~List~Ingredient~~
    }

    class RecipeAgent {
        -RecipeTool _recipeTool
        +FindRecipeIngredientsAsync(dishName, servings) Task~List~Ingredient~~
    }

    class IBudgetAgent {
        <<interface>>
        +BalanceBudgetAsync(targetBudget, items) Task~BudgetEvaluationResult~
    }

    class BudgetAgent {
        -ProductTool _productTool
        +BalanceBudgetAsync(targetBudget, items) Task~BudgetEvaluationResult~
    }

    class ICartAgent {
        <<interface>>
        +AddToCartAsync(cartId, items) Task~CartOperationResult~
    }

    class CartAgent {
        -CartTool _cartTool
        +AddToCartAsync(cartId, items) Task~CartOperationResult~
    }

    class ProductTool {
        -IProductService _productService
        +SearchAsync(query) Task~List~ProductDTO~~
        +GetAlternativeAsync(productId) Task~ProductDTO~
    }

    class InventoryTool {
        -IInventoryService _inventoryService
        +GetStockAsync(productId) Task~int~
        +GetNearExpiryAsync(days) Task~List~BatchDTO~~
    }

    class PromotionTool {
        -IPromotionService _promotionService
        +GetVouchersAsync() Task~List~VoucherDTO~~
        +GetFlashSaleAsync() Task~List~FlashSaleDTO~~
    }

    class RecipeTool {
        -IRecipeService _recipeService
        +GetRecipeAsync(dish) Task~RecipeDTO~
    }

    class CartTool {
        -IOrderService _orderService
        +AddItemsAsync(cartId, items) Task~bool~
    }

    AIController --> IAgentOrchestrator
    IAgentOrchestrator <|.. AgentOrchestrator
    AgentOrchestrator --> IShoppingAgent
    AgentOrchestrator --> IInventoryAgent
    AgentOrchestrator --> IPromotionAgent
    AgentOrchestrator --> IRecipeAgent
    AgentOrchestrator --> IBudgetAgent
    AgentOrchestrator --> ICartAgent

    IShoppingAgent <|.. ShoppingAgent
    IInventoryAgent <|.. InventoryAgent
    IPromotionAgent <|.. PromotionAgent
    IRecipeAgent <|.. RecipeAgent
    IBudgetAgent <|.. BudgetAgent
    ICartAgent <|.. CartAgent

    ShoppingAgent --> ProductTool
    InventoryAgent --> InventoryTool
    PromotionAgent --> PromotionTool
    RecipeAgent --> RecipeTool
    BudgetAgent --> ProductTool
    CartAgent --> CartTool
