flowchart LR
    subgraph DatabaseEntities["CÁC THỰC THỂ CSDL GỐC (DATABASE ENTITIES)"]
        P["Products<br/>- ProductId, ProductName, Price, Unit, Barcode"]
        C["Categories<br/>- CategoryId, CategoryName, Slug"]
        B["InventoryBatches<br/>- BatchCode, Quantity, ExpiryDate"]
        R["DiscountRules<br/>- DaysBeforeExpiry, DiscountPercent"]
        O["OrderDetails<br/>- OrderId, ProductId, Quantity"]
    end

