flowchart TD
    subgraph ClientLayer["1. Client Layer"]
        User([User / Khách Hàng]) --> UI["Angular / Web Chat UI"]
    end

    subgraph ControllerLayer["2. API Controller Layer"]
        UI -->|HTTP POST /api/ai/chat| Ctrl["AIController<br/>(Validate & Return DTO)"]
    end

    subgraph PipelineLayer["3. Context & Pipeline Layer"]
        Ctrl --> ConvSvc["ConversationService<br/>(Session Memory & Context History)"]
        ConvSvc --> PromptBld["PromptBuilder<br/>(System + Task + Fewshot + Knowledge)"]
    end

    subgraph OrchestrationLayer["4. Agent Orchestrator Layer"]
        PromptBld --> Orch["AgentOrchestrator<br/>(Intent Analysis & Multi-Agent Coordination)"]
        
        subgraph Agents["Agent Subsystem (BaseAgent Pattern)"]
            BaseAgent["IAgent / BaseAgent<br/>(Logging, Memory, Retry, Dispatch)"]
            ShopAgent["ShoppingAgent<br/>(Planning & Synthesis)"]
            InvAgent["InventoryAgent<br/>(Stock, Batches, Expiry)"]
            PromoAgent["PromotionAgent<br/>(Voucher, Flash Sale)"]
            RecAgent["RecipeAgent<br/>(Cookpad Knowledge)"]
            BudAgent["BudgetAgent<br/>(Rebalance & Substitutions)"]
            CartAgent["CartAgent<br/>(Add, Remove, Estimate)"]

            BaseAgent -.-> ShopAgent
            BaseAgent -.-> InvAgent
            BaseAgent -.-> PromoAgent
            BaseAgent -.-> RecAgent
            BaseAgent -.-> BudAgent
            BaseAgent -.-> CartAgent
        end
        Orch --> ShopAgent
        ShopAgent --> RecAgent
        ShopAgent --> InvAgent
        ShopAgent --> PromoAgent
        ShopAgent --> BudAgent
        ShopAgent --> CartAgent
    end

    subgraph GatewayLayer["5. LLM Gateway Layer"]
        LlmGw["ILLMGateway<br/>(Model Router & Resilient Fallback)"]
        GeminiGw["GeminiGateway<br/>(Gemini 2.5 Flash)"]
        GroqGw["GroqGateway<br/>(Llama 3.3 70B LPU)"]
        OpenAiGw["OpenAIGateway<br/>(GPT-4o Mini)"]
        LocalGw["LocalFallbackGateway<br/>(Deterministic Engine)"]

        LlmGw --> GeminiGw
        LlmGw --> GroqGw
        LlmGw --> OpenAiGw
        LlmGw --> LocalGw

        Agents <--> LlmGw
    end

    subgraph DispatcherLayer["6. Tool Dispatcher Layer"]
        Dispatcher["Tool Dispatcher<br/>(Logging, Retry, Timeout, Parallel Execution, Metrics)"]
        
        Agents --> Dispatcher
    end

    subgraph ToolLayer["7. Tool Layer"]
        ProdTool["ProductTool"]
        InvTool["InventoryTool"]
        PromoTool["PromotionTool"]
        RecTool["RecipeTool"]
        CartTool["CartTool"]

        Dispatcher --> ProdTool
        Dispatcher --> InvTool
        Dispatcher --> PromoTool
        Dispatcher --> RecTool
        Dispatcher --> CartTool
    end

    subgraph BusinessServiceLayer["8. Business Service Layer"]
        ProdSvc["ProductService"]
        InvSvc["InventoryService"]
        PromoSvc["PromotionService"]
        RecSvc["RecipeService"]
        OrderSvc["OrderService / CartService"]

        ProdTool --> ProdSvc
        InvTool --> InvSvc
        PromoTool --> PromoSvc
        RecTool --> RecSvc
        CartTool --> OrderSvc
    end

    subgraph RepositoryLayer["9. Repository Layer (EF Core)"]
        ProdRepo["ProductRepository"]
        InvRepo["InventoryRepository"]
        PromoRepo["PromotionRepository"]
        RecRepo["RecipeRepository"]
        OrderRepo["OrderRepository"]

        ProdSvc --> ProdRepo
        InvSvc --> InvRepo
        PromoSvc --> PromoRepo
        RecSvc --> RecRepo
        OrderSvc --> OrderRepo
    end

    subgraph DatabaseLayer["10. Data Persistence Layer"]
        DB[("SQL Server Database<br/>Products, InventoryBatches, Promotions, Orders, Recipes")]
        
        ProdRepo --> DB
        InvRepo --> DB
        PromoRepo --> DB
        RecRepo --> DB
        OrderRepo --> DB
    end
