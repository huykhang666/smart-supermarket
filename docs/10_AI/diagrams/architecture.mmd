flowchart TD
    subgraph Layer1["Layer 1: Frontend (Client Presentation)"]
        UI["Frontend Web Client<br/>(AI Chat Component)"]
    end

    subgraph Layer2["Layer 2: API Controller (Thin Layer)"]
        Ctrl["AIController<br/>POST /api/ai/chat<br/>(Validate & DTO Return)"]
    end

    subgraph Layer3["Layer 3: Agent Orchestrator (Brain & Multi-Agent)"]
        Orch["Agent Orchestrator<br/>(Phân tích Intent & Điều phối Agent)"]
        
        subgraph Agents["Specialized Agents"]
            ShoppingAgent["ShoppingAgent<br/>(Planning & Synthesis)"]
            InventoryAgent["InventoryAgent<br/>(Stock, Batches, Expiry)"]
            PromotionAgent["PromotionAgent<br/>(Voucher, Flash Sale, Promo)"]
            RecipeAgent["RecipeAgent<br/>(Cookpad DB & Ingredients)"]
            BudgetAgent["BudgetAgent<br/>(Tính tổng & Đề xuất thay thế)"]
            CartAgent["CartAgent<br/>(Add, Remove, Update, Estimate)"]
        end
    end

    subgraph Layer4["Layer 4: Tool Layer (Tool Dispatcher)"]
        Dispatcher["Tool Dispatcher"]
        ProductTool["ProductTool<br/>Search(), GetById()"]
        InventoryTool["InventoryTool<br/>GetStock(), GetNearExpiry(), GetAlternative()"]
        PromotionTool["PromotionTool<br/>GetVouchers(), CheckFlashSale()"]
        RecipeTool["RecipeTool<br/>GetRecipe(), GetIngredients()"]
        CartTool["CartTool<br/>AddToCart(), EstimateCart()"]
    end

    subgraph Layer5["Layer 5: Service Layer (Business Logic)"]
        ProductService["ProductService"]
        InventoryService["InventoryService<br/>(Lọc cận date <= 3 ngày, Flash Sale)"]
        PromotionService["PromotionService<br/>(Tính chiết khấu & điều kiện Voucher)"]
        RecipeService["RecipeService<br/>(Tra cứu cẩm nang Cookpad)"]
        OrderService["OrderService / CartService"]
    end

    subgraph Layer6["Layer 6: Repository Layer (EF Core Queries)"]
        ProductRepo["ProductRepository"]
        InventoryRepo["InventoryRepository"]
        PromotionRepo["PromotionRepository"]
        RecipeRepo["RecipeRepository"]
        OrderRepo["OrderRepository"]
    end

    subgraph Layer7["Layer 7: Persistence Layer"]
        DB[("SQL Server Database<br/>(Products, Inventory, Orders, Promotions, Recipes)")]
    end

    UI -->|HTTP POST /api/ai/chat| Ctrl
    Ctrl -->|Call Orchestrator| Orch

    Orch --> ShoppingAgent
    Orch --> InventoryAgent
    Orch --> PromotionAgent
    Orch --> RecipeAgent
    Orch --> BudgetAgent
    Orch --> CartAgent

    ShoppingAgent --> Dispatcher
    InventoryAgent --> Dispatcher
    PromotionAgent --> Dispatcher
    RecipeAgent --> Dispatcher
    BudgetAgent --> Dispatcher
    CartAgent --> Dispatcher

    Dispatcher --> ProductTool
    Dispatcher --> InventoryTool
    Dispatcher --> PromotionTool
    Dispatcher --> RecipeTool
    Dispatcher --> CartTool

    ProductTool --> ProductService
    InventoryTool --> InventoryService
    PromotionTool --> PromotionService
    RecipeTool --> RecipeService
    CartTool --> OrderService

    ProductService --> ProductRepo
    InventoryService --> InventoryRepo
    PromotionService --> PromotionRepo
    RecipeService --> RecipeRepo
    OrderService --> OrderRepo

    ProductRepo --> DB
    InventoryRepo --> DB
    PromotionRepo --> DB
    RecipeRepo --> DB
    OrderRepo --> DB
